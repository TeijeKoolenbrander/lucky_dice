.stage {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ---- the table: tray, dice, and the cup that covers them ---- */

/*
 * Sprites come from assets/images/, cut from the renders in visuals/. Sizes
 * keep each image's own aspect ratio: tray 600x406, cup 440x619, die 96x109.
 */
.table {
  position: relative;
  width: 100%;
  height: 1000rpx;
  margin-top: 30rpx;
}

/* The tray the dice sit in, wider than the cup so its rim rings the base. */
.mat {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 600rpx;
  height: 406rpx;
  margin-left: -300rpx;
}

/*
 * Kept narrower than the cup's base so every die stays inside its silhouette
 * when the cup is down. Its bottom sits ~38rpx above the cup's lowest edge to
 * leave room for the base curving up at the sides.
 *
 * z-index 1 makes the field its own stacking context, so the dice always
 * paint above the tray. cup.js also keeps every die's z-index positive. A
 * negative one used to sink a back-row die behind the tray, where it vanished.
 */
.dice-field {
  position: absolute;
  z-index: 1;
  left: 50%;
  bottom: 150rpx;
  width: 350rpx;
  height: 200rpx;
  margin-left: -175rpx;
}

.die {
  position: absolute;
  width: 96rpx;
  height: 109rpx;
  filter: drop-shadow(0 6rpx 6rpx rgba(0, 0, 0, 0.45));
}

/* ---- the cup ---- */

/*
 * z-index 200 keeps the cup above every die (the dice carry z-indexes of
 * 0-100 to depth-sort themselves). Its base sits on the tray floor, 112rpx
 * above the tray's front edge.
 */
.cup {
  position: absolute;
  left: 50%;
  bottom: 112rpx;
  z-index: 200;
  width: 440rpx;
  height: 619rpx;
  margin-left: -220rpx;
  transform: translateY(0);
  transform-origin: 50% 100%;
  transition: transform 0.45s cubic-bezier(0.22, 0.9, 0.3, 1);
}

/* 260rpx clears the back row of dice while keeping the cup on screen. */
.cup-up {
  transform: translateY(-260rpx);
}

.cup-img {
  display: block;
  width: 100%;
  height: 100%;
}

/* ---- shake ---- */

.cup-wobble {
  animation: wobble 0.22s linear infinite;
}

@keyframes wobble {
  0% {
    transform: translateY(0) rotate(0deg);
  }
  25% {
    transform: translateY(-14rpx) rotate(-7deg);
  }
  50% {
    transform: translateY(0) rotate(0deg);
  }
  75% {
    transform: translateY(-14rpx) rotate(7deg);
  }
  100% {
    transform: translateY(0) rotate(0deg);
  }
}

/* ---- hint ---- */

/* Positioned so the mat, which now hangs below the table, cannot cover it. */
.hint {
  position: relative;
  z-index: 1;
  margin-top: 10rpx;
  color: rgba(234, 241, 255, 0.34);
  font-size: 26rpx;
  letter-spacing: 6rpx;
  transition: opacity 0.3s;
}

.hint-off {
  opacity: 0;
}
